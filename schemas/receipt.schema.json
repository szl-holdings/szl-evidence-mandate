{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "szl.evidence.receipt/v1",
  "title": "SZL Evidence Gate receipt",
  "description": "A receipt supports integrity, provenance, and replayability. It does not establish scientific truth, accuracy, safety, or fitness for use.",
  "type": "object",
  "required": ["schema_version", "run_id", "tool", "started_at", "completed_at", "status", "exit_code", "invocations", "verdicts", "required_checks", "invocation_count", "limitations", "signature_state", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "szl.evidence.receipt/v1"},
    "run_id": {"type": "string"},
    "parent_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tool": {"type": "object", "required": ["name", "version", "code_revision"]},
    "manifest": {"type": "object"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "expected_inputs": {"type": "array", "items": {"type": "string"}},
    "observed_inputs": {"type": "object"},
    "evidence_manifest": {"type": "array"},
    "evidence_manifest_sha256": {"type": "string"},
    "accounting": {"type": "object"},
    "required_checks": {"type": "array", "items": {"type": "string"}},
    "invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "invocation_id", "check", "check_version", "input_ids", "input_hashes", "started_at", "completed_at", "result", "prev_sha256", "entry_sha256"],
        "properties": {
          "result": {
            "type": "object",
            "required": ["status", "reason", "evidence"],
            "properties": {
              "status": {"enum": ["PASS", "FAIL", "ABSTAIN", "ERROR"]},
              "reason": {"enum": ["VERIFIED", "UNVERIFIED", "INSUFFICIENT_EVIDENCE", "SOURCE_UNAVAILABLE", "SOURCE_MISMATCH", "PROTOCOL_BROKEN", "OUT_OF_SCOPE", "REQUIRES_HUMAN_REVIEW", "NOT_TESTED"]}
            }
          }
        }
      }
    },
    "verdicts": {"type": "array", "items": {"type": "object", "required": ["verdict_id", "invocation_id", "check", "verdict", "reason_code"]}},
    "invocation_count": {"type": "integer"},
    "ledger_head_sha256": {"type": "string"},
    "status": {"enum": ["PASS", "FAIL", "ABSTAIN", "ERROR"]},
    "exit_code": {"enum": [0, 1, 2, 3]},
    "pass_evidence": {"type": ["object", "null"]},
    "invariant_violations": {"type": "array"},
    "signature_state": {"enum": ["UNSIGNED", "SIGNED"]},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
